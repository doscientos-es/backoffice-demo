{
  "name": "doscientos-backoffice-demo",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:changed": "biome lint --changed --no-errors-on-unmatched",
    "lint:staged": "biome lint --staged --no-errors-on-unmatched",
    "lint:fix": "biome lint --write --unsafe .",
    "format": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --write .",
    "format:check": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --check .",
    "format:biome": "biome format --write .",
    "lint:oxlint": "oxlint",
    "lint:oxlint:fix": "oxlint --fix --fix-suggestions",
    "format:oxfmt": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --write .",
    "format:oxfmt:check": "oxfmt -c node_modules/@doscientos/configs/oxfmt.json --check .",
    "quality:common": "pnpm format:oxfmt:check && pnpm lint:oxlint && pnpm typecheck && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "env:example": "tsx scripts/generate-env-example.ts",
    "google:smoke": "tsx scripts/google-smoke.ts",
    "push:keys": "tsx scripts/generate-push-keys.ts",
    "quality:quick": "pnpm format:check && pnpm lint",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "hooks:install": "node .githooks/install.mjs"
  },
  "dependencies": {

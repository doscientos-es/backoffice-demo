    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@doscientos/configs": "^0.1.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/node-forge": "^1.3.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "3.2.4",

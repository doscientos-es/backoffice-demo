    "ibantools": "^4.5.4",
    "lru-cache": "^11.0.2",
    "lucide-react": "^1.11.0",
    "marked": "^18.0.5",
    "next": "^16.2.0",
    "next-themes": "^0.4.4",
    "node-forge": "^1.3.1",
    "pdfjs-dist": "^6.2.108",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
